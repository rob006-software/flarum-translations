{
    "flarum-mentions": {
        "admin": {
            "permissions": {
                "mention_groups_label": "提及用户组"
            },
            "settings": {
                "allow_username_format_label": "允许 @用户名",
                "allow_username_format_text": "Flarum 默认提及格式是「@外显名称#ID」，默认外显名称为用户名。\n启用 Nicknames 扩展程序后，你可能会将外显名称更改为昵称。开启此设置可允许用户同时使用旧格式「@用户名」，不过在保存时系统会自动转换成新格式。\n"
            }
        },
        "forum": {
            "composer": {
                "mention_tooltip": "提及用户、用户组或帖子",
                "reply_to_post_text": "回复 #{number}"
            },
            "mentioned_by": {
                "title": "此帖的回复",
                "load_more_button": "=> core.ref.load_more"
            },
            "notifications": {
                "others_text": "=> core.ref.some_others",
                "post_mentioned_text": "{username} 回复了你的帖子",
                "user_mentioned_text": "{username} 提及了你",
                "group_mentioned_text": "{username} 提及了你所在的用户组"
            },
            "post": {
                "mentioned_by_more_text": "还有 {count} 条回复",
                "mentioned_by_self_text": "{users} 回复了此帖",
                "mentioned_by_text": "{users} 回复了此帖",
                "others_text": "=> core.ref.some_others",
                "quote_button": "引用",
                "reply_link": "=> core.ref.reply",
                "you_text": "=> core.ref.you"
            },
            "settings": {
                "notify_post_mentioned_label": "有人回复我的帖子",
                "notify_user_mentioned_label": "有人在帖子中提及我",
                "notify_group_mentioned_label": "有人在帖子中提及我所在的用户组"
            },
            "user": {
                "mentions_link": "提及"
            },
            "post_mention": {
                "deleted_text": "[未知用户]"
            },
            "group_mention": {
                "deleted_text": "[未知用户组]"
            }
        },
        "email": {
            "post_mentioned": {
                "subject": "{replier_display_name} 回复了你的帖子 · {title}",
                "plain": {
                    "body": "{replier_display_name} 回复了你在「{title}」中的帖子（#{post_number}）。\n\n{url}\n\n---\n\n{content}\n"
                },
                "html": {
                    "body": "{replier_display_name} 回复了你在「[{title}]({url})」中的帖子（#{post_number}）。"
                }
            },
            "user_mentioned": {
                "subject": "{mentioner_display_name} 提及了你 · {title}",
                "plain": {
                    "body": "{mentioner_display_name} 在「{title}」的帖子中提及了你。\n\n{url}\n\n---\n\n{content}\n"
                },
                "html": {
                    "body": "{mentioner_display_name} 在「[{title}]({url})」的帖子中提及了你。"
                }
            },
            "group_mentioned": {
                "subject": "{mentioner_display_name} 提及了你所在的用户组 · {title}",
                "plain": {
                    "body": "{mentioner_display_name} 在「{title}」中提及了你所在的用户组。\n\n{url}\n\n---\n\n{content}\n"
                },
                "html": {
                    "body": "{mentioner_display_name} 在「[{title}]({url})」中提及了你所在的用户组。"
                }
            }
        },
        "lib": {
            "gambits": {
                "posts": {
                    "mentioned": {
                        "key": "提及",
                        "hint": "被提及用户 ID 或用户名"
                    }
                }
            }
        }
    }
